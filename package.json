{
  "name": "the-open-above",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Cinematic sky racing experience powered by Three.js with preserved NexusEngine compatibility.",
  "module": "src/main.js",
  "scripts": {
    "precheck": "node tools/write-nexus-build-diagnostics.mjs",
    "start": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "check": "node tests/run-tiered-checks.mjs",
    "build": "npm run check && vite build",
    "sanitize:check": "node tools/sanitize-repository.mjs",
    "showcase:prove": "node tools/prove-release-showcase.mjs",
    "showcase:inspect": "nexusengine inspect .",
    "showcase:plan": "nexusengine plan . --profile native-preferred --target web-live --target web-static --target android-xr --target pcvr"
  },
  "dependencies": {
    "nexusengine": "github:LuminaryLabs-Dev/NexusEngine#8a60167fc945109408851c586a9355b1147438d5",
    "three": "0.165.0"
  },
  "devDependencies": {
    "playwright": "1.61.1",
    "vite": "6.4.3"
  },
  "nexusengineBuild": {
    "include": [
      "index.html",
      "src"
    ],
    "entries": {
      "android-xr": "src/native/balloon-flight-kernel.js",
      "pcvr": "src/native/balloon-flight-kernel.js",
      "web-live": "src/main.js",
      "web-static": "src/main.js"
    }
  },
  "license": "UNLICENSED"
}
